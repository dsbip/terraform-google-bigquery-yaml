SELECT
  c.customer_id,
  `${project_id}.${datasets.udfs}.normalize_email`(c.email) AS email,
  c.country_code,
  c.first_order_date,
  COUNT(o.order_id) AS orders,
  SUM(o.amount) AS lifetime_value,
  MAX(o.order_date) AS last_order_date
FROM `${project_id}.${datasets.core}.dim_customer` AS c
LEFT JOIN (
  SELECT customer_id, order_id, order_date, amount
  FROM `${project_id}.${datasets.core}.fct_orders`
  WHERE order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 YEAR)
) AS o
  ON o.customer_id = c.customer_id
GROUP BY c.customer_id, email, c.country_code, c.first_order_date
