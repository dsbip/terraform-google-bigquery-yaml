BEGIN
  CREATE OR REPLACE TEMP TABLE first_orders AS
  SELECT customer_id, MIN(DATE(created_at)) AS first_order_date
  FROM `${project_id}.${datasets.raw}.orders`
  GROUP BY customer_id;

  MERGE `${project_id}.${datasets.core}.dim_customer` AS t
  USING (
    SELECT
      c.customer_id,
      `${project_id}.${datasets.udfs}.normalize_email`(c.email) AS email,
      c.country_code,
      f.first_order_date
    FROM `${project_id}.${datasets.raw}.customers` AS c
    LEFT JOIN first_orders AS f USING (customer_id)
  ) AS s
  ON t.customer_id = s.customer_id
  WHEN MATCHED THEN
    UPDATE SET email = s.email, country_code = s.country_code, first_order_date = s.first_order_date
  WHEN NOT MATCHED THEN
    INSERT (customer_id, email, country_code, first_order_date)
    VALUES (s.customer_id, s.email, s.country_code, s.first_order_date);
END
